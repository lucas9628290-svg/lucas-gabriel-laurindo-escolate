const GROUP_SIZE = 4;
const GROUP_LETTERS = ["A", "B", "C", "D", "E", "F", "G", "H"];

// ---------------------------------------------------------------------------
// Utilidades de simulação
// ---------------------------------------------------------------------------
function shuffle(array) {
  const a = [...array];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

/** Gera um placar plausível ponderado pela diferença de rating dos times. */
function simulateScore(teamA, teamB) {
  const diff = teamA.rating - teamB.rating;
  const baseA = 1.35 + diff / 45;
  const baseB = 1.35 - diff / 45;
  const poisson = (lambda) => {
    const L = Math.exp(-Math.max(lambda, 0.15));
    let k = 0;
    let p = 1;
    do {
      k++;
      p *= Math.random();
    } while (p > L);
    return k - 1;
  };
  return [poisson(baseA), poisson(baseB)];
}

function buildGroups(teams) {
  const shuffled = shuffle(teams);
  const groups = [];
  for (let i = 0; i < shuffled.length; i += GROUP_SIZE) {
    groups.push({
      letter: GROUP_LETTERS[groups.length],
      teams: shuffled.slice(i, i + GROUP_SIZE),
    });
  }
  return groups;
}

function emptyStandings(teams) {
  return Object.fromEntries(
    teams.map((t) => [t.id, { team: t, pts: 0, gf: 0, ga: 0, gd: 0, played: 0 }])
  );
}

function playGroupStage(groups) {
  return groups.map((group) => {
    const standings = emptyStandings(group.teams);
    const matches = [];
    for (let i = 0; i < group.teams.length; i++) {
      for (let j = i + 1; j < group.teams.length; j++) {
        const a = group.teams[i];
        const b = group.teams[j];
        const [sa, sb] = simulateScore(a, b);
        matches.push({ a, b, sa, sb });
        const sA = standings[a.id];
        const sB = standings[b.id];
        sA.played++;
        sB.played++;
        sA.gf += sa;
        sA.ga += sb;
        sB.gf += sb;
        sB.ga += sa;
        if (sa > sb) sA.pts += 3;
        else if (sb > sa) sB.pts += 3;
        else {
          sA.pts += 1;
          sB.pts += 1;
        }
      }
    }
    Object.values(standings).forEach((s) => (s.gd = s.gf - s.ga));
    const ranked = Object.values(standings).sort(
      (x, y) => y.pts - x.pts || y.gd - x.gd || y.gf - x.gf
    );
    return { ...group, matches, ranked, qualified: ranked.slice(0, 2) };
  });
}

/** Monta o chaveamento mata-mata cruzando 1º de um grupo com 2º do próximo. */
function buildKnockoutSeed(playedGroups) {
  const firsts = playedGroups.map((g) => g.qualified[0].team);
  const seconds = playedGroups.map((g) => g.qualified[1].team);
  const seconds2 = shuffle(seconds);
  const round = [];
  for (let i = 0; i < firsts.length; i++) {
    round.push([firsts[i], seconds2[(i + 1) % seconds2.length]]);
  }
  return shuffle(round);
}

function playKnockoutMatch(teamA, teamB) {
  let [sa, sb] = simulateScore(teamA, teamB);
  let penalties = null;
  if (sa === sb) {
    let pa = 3 + Math.floor(Math.random() * 3);
    let pb = 3 + Math.floor(Math.random() * 3);
    while (pa === pb) {
      pa = 3 + Math.floor(Math.random() * 3);
      pb = 3 + Math.floor(Math.random() * 3);
    }
    penalties = [pa, pb];
  }
  const winner = penalties
    ? penalties[0] > penalties[1]
      ? teamA
      : teamB
    : sa > sb
    ? teamA
    : teamB;
  return { teamA, teamB, sa, sb, penalties, winner };
}

const STAGE_LABELS = {
  16: "Oitavas de final",
  8: "Quartas de final",
  4: "Semifinal",
  2: "Final",
};

// ---------------------------------------------------------------------------
// Subcomponentes visuais
// ---------------------------------------------------------------------------
function TeamChip({ team, bold, faded }) {
  if (!team) {
    return (
      <div className="wc-chip wc-chip--empty">
        <span>A definir</span>
      </div>
    );
  }
  return (
    <div className={`wc-chip ${faded ? "wc-chip--faded" : ""}`}>
      <span className="wc-chip__dot" style={{ background: team.color }} />
      <span className={bold ? "wc-chip__name wc-chip__name--bold" : "wc-chip__name"}>
        {team.name}
      </span>
      <span className="wc-chip__rating">{team.rating}</span>
    </div>
  );
}

function GroupTable({ group }) {
  return (
    <div className="wc-group">
      <div className="wc-group__header">
        <span className="wc-group__letter">Grupo {group.letter}</span>
      </div>
      <table className="wc-table">
        <thead>
          <tr>
            <th className="wc-table__team-col">Seleção</th>
            <th>P</th>
            <th>SG</th>
            <th>GP</th>
          </tr>
        </thead>
        <tbody>
          {group.ranked.map((row, idx) => (
            <tr key={row.team.id} className={idx < 2 ? "wc-table__row--qualified" : ""}>
              <td className="wc-table__team-col">
                <span className="wc-table__pos">{idx + 1}</span>
                <span className="wc-chip__dot" style={{ background: row.team.color }} />
                {row.team.name}
              </td>
              <td>{row.pts}</td>
              <td>{row.gd > 0 ? `+${row.gd}` : row.gd}</td>
              <td>{row.gf}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

function KnockoutMatch({ match, onClick, playable }) {
  if (!match) return null;
  const { teamA, teamB, result } = match;
  return (
    <button
      className={`wc-bracket-match ${playable ? "wc-bracket-match--playable" : ""}`}
      onClick={playable ? onClick : undefined}
      disabled={!playable}
      type="button"
    >
      <div className={`wc-bracket-row ${result && result.winner.id === teamA?.id ? "wc-bracket-row--winner" : ""}`}>
        <TeamChip team={teamA} />
        {result && <span className="wc-bracket-score">{result.sa}</span>}
      </div>
      <div className={`wc-bracket-row ${result && result.winner.id === teamB?.id ? "wc-bracket-row--winner" : ""}`}>
        <TeamChip team={teamB} />
        {result && <span className="wc-bracket-score">{result.sb}</span>}
      </div>
      {result?.penalties && (
        <div className="wc-bracket-pens">
          pênaltis {result.penalties[0]}–{result.penalties[1]}
        </div>
      )}
      {!result && playable && <div className="wc-bracket-cta">apitar jogo <ChevronRight size={13} /></div>}
    </button>
  );
}

// ---------------------------------------------------------------------------
// Componente principal
// ---------------------------------------------------------------------------
export default function WorldCupSimulator() {
  const [stage, setStage] = useState("setup"); // setup | groups | knockout | champion
  const [groups, setGroups] = useState([]);
  const [rounds, setRounds] = useState([]); // array de arrays de matches
  const [champion, setChampion] = useState(null);

  const allTeams = TEAMS;

  const startDraw = useCallback(() => {
    const g = buildGroups(allTeams);
    const played = playGroupStage(g);
    setGroups(played);
    const seed = buildKnockoutSeed(played);
    const r16 = seed.map(([a, b]) => ({ teamA: a, teamB: b, result: null }));
    setRounds([r16]);
    setChampion(null);
    setStage("knockout");
  }, [allTeams]);

  const playMatch = useCallback(
    (roundIdx, matchIdx) => {
      setRounds((prev) => {
        const next = prev.map((r) => r.map((m) => ({ ...m })));
        const match = next[roundIdx][matchIdx];
        if (!match.teamA || !match.teamB || match.result) return prev;
        match.result = playKnockoutMatch(match.teamA, match.teamB);

        const isLastRound = next.length === roundIdx + 1;
        const roundComplete = next[roundIdx].every((m) => m.result);

        if (next[roundIdx].length === 1) {
          setChampion(match.result.winner);
          setStage("champion");
          return next;
        }

        if (isLastRound) {
          const winners = [];
          for (let i = 0; i < next[roundIdx].length; i += 2) {
            const m1 = next[roundIdx][i];
            const m2 = next[roundIdx][i + 1];
            winners.push({
              teamA: m1.result ? m1.result.winner : null,
              teamB: m2 && m2.result ? m2.result.winner : null,
              result: null,
            });
          }
          if (roundComplete) next.push(winners);
        } else if (roundComplete) {
          // popula próxima rodada já existente (caso parcialmente jogada)
          const nextRound = next[roundIdx + 1];
          for (let i = 0; i < next[roundIdx].length; i += 2) {
            const pairIdx = i / 2;
            nextRound[pairIdx].teamA = next[roundIdx][i].result.winner;
            nextRound[pairIdx].teamB = next[roundIdx][i + 1]?.result?.winner ?? null;
          }
        }
        return next;
      });
    },
    []
  );

  const reset = useCallback(() => {
    setStage("setup");
    setGroups([]);
    setRounds([]);
    setChampion(null);
  }, []);

  const totalQualified = useMemo(
    () => groups.flatMap((g) => g.qualified.map((q) => q.team)),
    [groups]
  );

  return (
    <div className="wc-app">
      <style>{CSS}</style>

      <header className="wc-header">
        <div className="wc-header__mark">
          <Trophy size={22} />
        </div>
        <div>
          <h1 className="wc-header__title">Copa Simulada</h1>
          <p className="wc-header__subtitle">torneio fictício · {allTeams.length} seleções · {GROUP_LETTERS.slice(0, allTeams.length / GROUP_SIZE).length} grupos</p>
        </div>
        {stage !== "setup" && (
          <button className="wc-reset" onClick={reset} type="button">
            <RotateCcw size={14} /> reiniciar
          </button>
        )}
      </header>

      {stage === "setup" && (
        <div className="wc-setup">
          <div className="wc-setup__field">
            <Flag size={32} />
            <h2>Sorteie os grupos e dispute o título</h2>
            <p>
              {allTeams.length} seleções fictícias entram em {Math.floor(allTeams.length / GROUP_SIZE)} grupos de {GROUP_SIZE}.
              Os dois melhores de cada grupo avançam ao mata-mata, onde você decide quando apitar cada jogo.
            </p>
            <button className="wc-cta" onClick={startDraw} type="button">
              <Shuffle size={16} /> sortear grupos
            </button>
          </div>
        </div>
      )}

      {stage !== "setup" && (
        <section className="wc-groups">
          <h3 className="wc-section-title">Fase de grupos</h3>
          <div className="wc-groups__grid">
            {groups.map((g) => (
              <GroupTable key={g.letter} group={g} />
            ))}
          </div>
        </section>
      )}

      {(stage === "knockout" || stage === "champion") && (
        <section className="wc-knockout">
          <h3 className="wc-section-title">Mata-mata</h3>
          <div className="wc-bracket">
            {rounds.map((round, rIdx) => (
              <div className="wc-bracket-col" key={rIdx}>
                <div className="wc-bracket-col__label">{STAGE_LABELS[round.length * 2] ?? STAGE_LABELS[2]}</div>
                {round.map((m, mIdx) => (
                  <KnockoutMatch
                    key={mIdx}
                    match={m}
                    playable={!!m.teamA && !!m.teamB && !m.result}
                    onClick={() => playMatch(rIdx, mIdx)}
                  />
                ))}
              </div>
            ))}
          </div>
        </section>
      )}

      {stage === "champion" && champion && (
        <section className="wc-champion">
          <Trophy size={40} />
          <span className="wc-champion__eyebrow">campeã da Copa Simulada</span>
          <h2 className="wc-champion__name" style={{ color: champion.color }}>
            {champion.name}
          </h2>
          <button className="wc-cta" onClick={reset} type="button">
            <Shuffle size={16} /> simular outro torneio
          </button>
        </section>
      )}
    </div>
  );
}

